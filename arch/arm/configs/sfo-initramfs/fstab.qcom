# Android 17 first-stage init needs this before /system and /vendor are mounted.
# The later mounts remain in the device's /vendor/etc/fstab.qcom.
# Use the platform symlink generated from the system partition uevent.
/dev/block/platform/msm_sdcc.1/by-name/system /system ext4 ro,barrier=1,discard wait,first_stage_mount
